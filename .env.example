# Zkopírujte do .env.local a doplňte hodnoty.
# Veřejné údaje: Supabase dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tajné (server-only, nikdy necommitovat):
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...
